#!/usr/bin/env bash
# A general, all-purpose extraction script.
#
# Default behavior: Extract archive into new directory
# Behavior with `-c` option: Extract contents into current directory

usage() {
    printf 'Usage: %s [-c] ARCHIVE\n' "$(basename "$0")"
    printf '  -c  Extract into the current directory.\n'
    printf '  -h, --help  Show this help.\n'
}

extract_here=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        -c) extract_here=true; shift ;;
        -h | --help) usage; exit 0 ;;
        --) shift; break ;;
        -*) usage >&2; exit 2 ;;
        *) break ;;
    esac
done

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi

archive="$(readlink -f -- "$1")" || exit 1

if [ ! -f "$archive" ]; then
    printf 'File "%s" not found.\n' "$archive" >&2
    exit 1
fi

if ! "$extract_here"; then
    directory="$(printf '%s\n' "$archive" | sed 's/\.[^\/.]*$//')"
    mkdir -p -- "$directory" || exit
    cd -- "$directory" || exit
fi

case "$archive" in
        *.tar.bz2|*.tar.xz|*.tbz2) tar xvjf "$archive" ;;
        *.tar.gz|*.tgz) tar xvzf "$archive" ;;
        *.lzma) unlzma "$archive" ;;
        *.bz2) bunzip2 "$archive" ;;
        *.rar) unrar x -ad "$archive" ;;
        *.gz) gunzip "$archive" ;;
        *.tar) tar xvf "$archive" ;;
        *.zip) unzip "$archive" ;;
        *.Z) uncompress "$archive" ;;
        *.7z) 7z x "$archive" ;;
        *.xz) unxz "$archive" ;;
        *.exe) cabextract "$archive" ;;
        *) printf "extract: '%s' - unknown archive method\\n" "$archive" ;;
esac
