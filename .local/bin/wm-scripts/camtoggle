#!/usr/bin/env bash

set -u

camera="${1:-0}"
if [[ ! "$camera" =~ ^[0-9]+$ ]]; then
	printf 'Usage: %s [CAMERA_NUMBER]\n' "$(basename "$0")" >&2
	exit 2
fi

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="$runtime_dir/camtoggle-${UID}-${camera}.pid"

if [[ -r "$pid_file" ]]; then
	read -r camera_pid < "$pid_file"
	if [[ "$camera_pid" =~ ^[0-9]+$ ]] && kill -0 "$camera_pid" 2>/dev/null; then
		command_line="$(tr '\0' ' ' < "/proc/$camera_pid/cmdline" 2>/dev/null || true)"
		if [[ "$command_line" == *mpv*"av://v4l2:/dev/video${camera}"* ]]; then
			kill "$camera_pid"
			exit 0
		fi
	fi
	rm -f -- "$pid_file"
fi

mpv --no-osc \
	--no-input-default-bindings \
	--input-conf=/dev/null \
	--geometry=-0-0  \
	--autofit=30%  \
	--title="mpvfloat" "av://v4l2:/dev/video${camera}" &
camera_pid=$!
printf '%s\n' "$camera_pid" > "$pid_file"
trap 'rm -f -- "$pid_file"' EXIT INT TERM
wait "$camera_pid"
